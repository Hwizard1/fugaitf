/* ═══════════════════════════════════════════════
   INIT — Populate state dropdowns
═══════════════════════════════════════════════ */
function populateStates() {
  const states = Object.keys(statesLGAs).sort();
  ['stateOrigin','statePlacement'].forEach(id => {
    const sel = document.getElementById(id);
    states.forEach(s => {
      const o = document.createElement('option');
      o.value = o.textContent = s;
      sel.appendChild(o);
    });
  });
}

function populateLGA(stateSelId, lgaSelId) {
  const state = document.getElementById(stateSelId).value;
  const lgaSel = document.getElementById(lgaSelId);
  lgaSel.innerHTML = '<option value="">Select LGA</option>';
  if (state && statesLGAs[state]) {
    lgaSel.disabled = false;
    statesLGAs[state].forEach(lga => {
      const o = document.createElement('option');
      o.value = o.textContent = lga;
      lgaSel.appendChild(o);
    });
  } else {
    lgaSel.disabled = true;
  }
}

function loadDepartments() {
  const faculty = document.getElementById('faculty').value;
  const deptSel = document.getElementById('department');
  deptSel.innerHTML = '<option value="">Select department</option>';
  if (faculty && facultyDepts[faculty]) {
    deptSel.disabled = false;
    facultyDepts[faculty].forEach(d => {
      const o = document.createElement('option');
      o.value = o.textContent = d;
      deptSel.appendChild(o);
    });
  } else {
    deptSel.disabled = true;
  }
}

/* ═══════════════════════════════════════════════
   PHOTO PREVIEW
═══════════════════════════════════════════════ */
function previewPhoto(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      const img = document.getElementById('photoImg');
      img.src = e.target.result;
      img.style.display = 'block';
      document.getElementById('photoPlaceholder').style.display = 'none';
    };
    reader.readAsDataURL(input.files[0]);
  }
}

